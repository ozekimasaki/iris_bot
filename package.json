{
  "name": "iris-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Iris is a reusable Discord operations bot for multi-guild deployments.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc --noEmit --project tsconfig.json",
    "start": "bun run src/index.ts",
    "test": "bun run src/test/smoke.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "commands:sync": "bun run src/app/command-sync.ts"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "pino": "^9.14.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "lodash": "4.18.1",
    "undici": "6.24.1",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.0",
    "typescript": "^5.9.3"
  }
}
